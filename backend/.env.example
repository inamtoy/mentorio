DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value

DB_NAME=educore
DB_HOST=localhost
DB_PORT=5432

# App connection role — NOT the table owner. Must NOT have BYPASSRLS,
# so `FORCE ROW LEVEL SECURITY` actually applies to it.
DB_USER=educore_app
DB_PASSWORD=

# Distinct role used only for the login_id -> user lookup during login,
# which necessarily runs before any org context (and thus RLS policy) applies.
DB_AUTH_BYPASS_USER=educore_auth_bypass
DB_AUTH_BYPASS_PASSWORD=

DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
DB_CONN_MAX_AGE=60

# Encrypts Payme/Click merchant secret_keys at rest (common/fields.py).
# Safe to leave unset for local dev (falls back to a key derived from
# DJANGO_SECRET_KEY — see config/settings/base.py) — but a real deployment
# MUST set this explicitly, so it's rotatable independently of SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_GATEWAY_ENCRYPTION_KEY=

# Telegram bot (password reset + notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
