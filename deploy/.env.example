# Copy to .env (never commit it) and fill in every empty value.
# Generate passwords/secrets with:  openssl rand -base64 36 | tr -d '/+='

# Public domain; its DNS A record must point at this server.
DOMAIN=

# Postgres superuser. Only used by the db container itself.
POSTGRES_PASSWORD=

DB_NAME=educore
# Owns the schema; used only by the migrate service.
DB_OWNER_USER=educore_owner
DB_OWNER_PASSWORD=
# Every normal request. Row-level security applies to it.
DB_USER=educore_app
DB_PASSWORD=
# Login lookup and backups only (BYPASSRLS).
DB_AUTH_BYPASS_USER=educore_auth_bypass
DB_AUTH_BYPASS_PASSWORD=

DJANGO_SECRET_KEY=
# Encrypts Payme/Click merchant keys at rest. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PAYMENT_GATEWAY_ENCRYPTION_KEY=

# Production Telegram bot (a different bot from the local-dev one).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional
GUNICORN_WORKERS=3
DB_BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO
