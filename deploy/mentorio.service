# Mentorio API (Django + gunicorn). Listens on localhost only; nginx is the
# one public entry point (deploy/nginx-mentorio.conf). Settings and
# secrets come from backend/.env, which Django reads itself.
[Unit]
Description=Mentorio API (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/mentorio/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/deploy/mentorio/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8001 --workers 3 --timeout 120 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
