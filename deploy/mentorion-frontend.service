# Mentorio web app: the Next.js standalone server (needs Node — the app
# uses server-side routing guards in proxy.ts, so it can't be a static
# export). deploy.sh copies .next/static and public/ into the bundle.
[Unit]
Description=Mentorio frontend (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/mentorion/frontend/.next/standalone
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
