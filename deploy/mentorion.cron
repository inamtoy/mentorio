# Installed to /etc/cron.d/mentorion by setup_server.sh. Server timezone is
# Asia/Tashkent. Monthly invoices first, then reminders, so a fresh invoice
# that is due soon gets its reminder the same morning.
SHELL=/bin/sh
M=/home/deploy/mentorion/backend
0 8 * * * deploy cd $M && DJANGO_SETTINGS_MODULE=config.settings.prod .venv/bin/python manage.py issue_monthly_invoices >> /var/log/mentorion/cron.log 2>&1
0 9 * * * deploy cd $M && DJANGO_SETTINGS_MODULE=config.settings.prod .venv/bin/python manage.py send_payment_reminders >> /var/log/mentorion/cron.log 2>&1
# Daily database backup, kept 7 days (deploy/backup.sh).
0 3 * * * root /home/deploy/mentorion/deploy/backup.sh mentorion >> /var/log/mentorion/backup.log 2>&1
