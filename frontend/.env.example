# Copy to .env.local (dev) or .env.production (server build). Inlined into
# the client bundle at build time.
#
# Origin of the Django API; every request path already starts with /api/.
#   Local dev (backend on another port):  NEXT_PUBLIC_API_URL=http://localhost:8000
#   Production (nginx serves /api/ on the same origin): leave it empty, so
#   requests are relative and the same build works on any host or scheme.
NEXT_PUBLIC_API_URL=
